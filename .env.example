# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/parse-receipt).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional backend API base URL for standalone Capacitor Android / static web builds
# (e.g. https://your-parserpro-api.onrender.com). When unset on Android, ParserPro
# automatically uses its bundled on-device ML Kit + Tesseract failsafe scanner.
VITE_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
